# Backend Environment Variables
# Copy to .env and fill in your values

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/kortix"
# Optional: Read replica for high-traffic read operations
# DATABASE_READ_REPLICA_URL="postgresql+asyncpg://user:password@replica:5432/kortix"

# =============================================================================
# REDIS (Caching & Rate Limiting)
# =============================================================================
REDIS_URL="redis://localhost:6379"

# =============================================================================
# SUPABASE
# =============================================================================
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# =============================================================================
# LITESTAR V2 API (Performance Migration)
# =============================================================================
# Master switch for Litestar /v2 endpoints
ENABLE_LITESTAR_V2="true"

# Traffic percentage to route to Litestar (0-100)
# Start at 1% for canary, gradually increase to 100%
LITESTAR_TRAFFIC_PERCENT="100"

# Automatic rollback threshold (5xx error rate %)
ROLLBACK_ERROR_THRESHOLD="1.0"

# =============================================================================
# OBSERVABILITY (OpenTelemetry)
# =============================================================================
# OpenTelemetry Collector endpoint
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"
OTEL_SERVICE_NAME="kortix-backend"

# Log level
LOG_LEVEL="INFO"

# =============================================================================
# AI/LLM PROVIDERS
# =============================================================================
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
# Composio (tool integrations)
COMPOSIO_API_KEY=""

# Daytona (sandbox environments)
DAYTONA_API_KEY=""
DAYTONA_SERVER_URL=""

# =============================================================================
# SECURITY
# =============================================================================
# JWT secret for token signing (generate with: openssl rand -hex 32)
JWT_SECRET=""

# CORS origins (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:8081"
