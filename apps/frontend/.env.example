NEXT_PUBLIC_ENV_MODE="staging" #production, or staging
NEXT_PUBLIC_DISABLE_MOBILE_ADVERTISING="true"

# Supabase credentials - get from your Supabase project dashboard
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

NEXT_PUBLIC_BACKEND_URL="http://localhost:8000/v1"
NEXT_PUBLIC_BACKEND_URL_V2="http://localhost:8000/v2"

# Litestar V2 API Settings
NEXT_PUBLIC_API_V2_ENABLED="true"
NEXT_PUBLIC_SPECULATION_ENABLED="true"

NEXT_PUBLIC_URL="http://localhost:3000"

NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
NEXT_PUBLIC_POSTHOG_KEY=""
KORTIX_ADMIN_API_KEY=""

EDGE_CONFIG="https://edge-config.vercel.com/REDACTED?token=REDACTED"

NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_GA_ID_1=""
NEXT_PUBLIC_GA_ID_2=""
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=""

NEXT_PUBLIC_FORCE_LOCALHOST="true"