# Mobile App Environment Variables
# Copy to .env and fill in your values

# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Backend API
EXPO_PUBLIC_BACKEND_URL="http://localhost:8000/v1"
EXPO_PUBLIC_BACKEND_URL_V2="http://localhost:8000/v2"

# Litestar V2 API Settings
EXPO_PUBLIC_USE_V2_API="true"

# Frontend URL (for auth redirects, sharing)
EXPO_PUBLIC_FRONTEND_URL="http://localhost:3000"

# Development host (for Android emulator)
# EXPO_PUBLIC_DEV_HOST="10.0.2.2"
