---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const docs = (await getCollection('docs'))
  .sort((a, b) => a.data.order - b.data.order);

// Group by category
const categories = docs.reduce((acc, doc) => {
  const cat = doc.data.category;
  if (!acc[cat]) acc[cat] = [];
  acc[cat].push(doc);
  return acc;
}, {} as Record<string, typeof docs>);
---

<BaseLayout title="Documentation">
  <Header />
  
  <main class="pt-28 pb-20">
    <div class="container mx-auto px-6">
      <h1 class="text-4xl font-bold mb-12">Documentation</h1>
      
      {Object.keys(categories).length === 0 ? (
        <p class="text-gray-400">Documentation coming soon!</p>
      ) : (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {Object.entries(categories).map(([category, categoryDocs]) => (
            <div class="bg-gray-800 rounded-xl p-6">
              <h2 class="text-lg font-semibold mb-4">{category}</h2>
              <ul class="space-y-2">
                {categoryDocs.map(doc => (
                  <li>
                    <a 
                      href={`/docs/${doc.slug}`}
                      class="text-gray-400 hover:text-white transition-colors"
                    >
                      {doc.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      )}
    </div>
  </main>
  
  <Footer />
</BaseLayout>
